{
  "name": "bengkelin",
  "productName": "Bengkelin",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi kasir bengkel motor (offline, satu komputer)",
  "keywords": [],
  "license": "MIT",
  "author": "dev",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release:check": "node scripts/release-check.mts",
    "smoke:packaged": "node scripts/smoke-packaged.mts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build:app": "node scripts/build-app.mts",
    "print:samples": "node scripts/print-samples.mts",
    "fixtures:db": "node scripts/make-db-fixture.mts",
    "test:domain": "vitest run --project domain",
    "test:integration": "node scripts/run-under-electron.mjs node_modules/vitest/vitest.mjs run --project integration",
    "test:renderer": "vitest run --project renderer",
    "test:e2e": "npm run build:app && playwright test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.86.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "electron-squirrel-startup": "^1.0.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.5.1": true
  }
}
